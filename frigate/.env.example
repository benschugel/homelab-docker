# Copy to .env and fill in. Frigate substitutes {VAR} placeholders in config.yml from these.
PLUS_API_KEY=
FRIGATE_MQTT_PASSWORD=CHANGE_ME
FRIGATE_DRIVEWAY_PASSWORD=CHANGE_ME
FRIGATE_LITTER_USER=CHANGE_ME
FRIGATE_LITTER_PASSWORD=CHANGE_ME
FRIGATE_RTSP_USER=CHANGE_ME
FRIGATE_RTSP_PASSWORD=CHANGE_ME
# Hosts, so the tracked config.yml carries no LAN addresses
FRIGATE_MQTT_HOST=CHANGE_ME
FRIGATE_LAN_IP=CHANGE_ME
FRIGATE_DRIVEWAY_HOST=CHANGE_ME
FRIGATE_LITTER_HOST=CHANGE_ME
