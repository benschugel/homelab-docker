# Wazuh MCP Server - environment
# Copy to .env and fill in. Reference: https://github.com/gensecaihq/Wazuh-MCP-Server/blob/main/docs/configuration.md

WAZUH_HOST=wazuh.manager
WAZUH_PORT=55000
# Dedicated read-only API user; created by create-mcp-user.ps1
WAZUH_USER=mcp-readonly
WAZUH_PASS=CHANGE_ME
WAZUH_ALLOW_SELF_SIGNED=true

WAZUH_INDEXER_HOST=wazuh.indexer
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=CHANGE_ME
WAZUH_INDEXER_SSL=true
WAZUH_INDEXER_VERIFY_SSL=false

AUTH_MODE=api_key
AUTH_SECRET_KEY=CHANGE_ME_long_random_string
MCP_API_KEY=CHANGE_ME_long_random_string
# Read-only. Change to "wazuh:read wazuh:write" (quoted) to allow active response later.
MCP_API_KEY_SCOPES=wazuh:read
TOKEN_LIFETIME_HOURS=8760

ALLOWED_ORIGINS=http://127.0.0.1:3000

# "response" toolset left out while the key is read-only
WAZUH_TOOLSETS=alerts,agents,vulnerabilities,rules
WAZUH_PROTECTED_IPS=192.168.0.0/16,127.0.0.1

LOG_LEVEL=INFO
