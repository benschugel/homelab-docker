# Shared by the db and webserver containers.
# Copy to paperless.env and replace every CHANGE_ME. DB password must match in both places.

# Postgres
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=CHANGE_ME

# Paperless database + broker
PAPERLESS_DBHOST=db
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=CHANGE_ME
PAPERLESS_REDIS=redis://broker:6379

# Core
PAPERLESS_SECRET_KEY=CHANGE_ME_long_random_string
PAPERLESS_TIME_ZONE=America/Chicago
PAPERLESS_OCR_LANGUAGE=eng
# US-style dates on receipts (MM/DD/YYYY)
PAPERLESS_DATE_ORDER=MDY
# Refuse a file that is already in Paperless instead of importing a second copy
PAPERLESS_CONSUMER_DELETE_DUPLICATES=true

# URL you browse to. If you'll open it from another device, list both, e.g.
# PAPERLESS_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://192.168.x.x:8000
PAPERLESS_URL=http://localhost:8000

# Windows bind mounts don't pass file events, so poll the consume folder (seconds)
PAPERLESS_CONSUMER_POLLING=10

# Office/email ingestion (remove if you dropped gotenberg/tika)
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg:3000
PAPERLESS_TIKA_ENDPOINT=http://tika:9998
