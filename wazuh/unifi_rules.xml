<group name="unifi,">

  <rule id="100100" level="3">
    <decoded_as>unifi-cef</decoded_as>
    <description>UniFi: $(unifi.event_name)</description>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="unifi.event_name">Blocked by Firewall</field>
    <description>UniFi firewall block: $(srcip) ($(unifi.src_zone)) to $(unifi.dst_zone) port $(dstport), policy $(unifi.policy)</description>
    <group>firewall,</group>
  </rule>

  <rule id="100102" level="10">
    <if_sid>100100</if_sid>
    <field name="unifi.event_name">Honeypot</field>
    <description>UniFi honeypot triggered by $(unifi.client_alias) ($(srcmac))</description>
    <group>attack,honeypot,</group>
  </rule>

  <rule id="100103" level="10">
    <if_sid>100100</if_sid>
    <field name="unifi.event_name">Threat Detected</field>
    <description>UniFi IPS: $(unifi.msg)</description>
    <group>ids,</group>
  </rule>

  <rule id="100104" level="12" frequency="8" timeframe="60">
    <if_matched_sid>100101</if_matched_sid>
    <same_srcip />
    <description>UniFi: 8+ firewall blocks from $(srcip) in 60s, possible scan</description>
    <group>recon,</group>
  </rule>

  <!-- Client churn (2026-10-07). Roaming between access points is dropped
       outright. Connect and disconnect stay at level 1: stored since the
       manager logs level 1 and up, and still usable by frequency rules. -->

  <rule id="100105" level="0">
    <if_sid>100100</if_sid>
    <field name="unifi.event_name" type="pcre2">^WiFi Client Roamed$</field>
    <description>UniFi: client roamed between access points (ignored)</description>
  </rule>

  <rule id="100106" level="1">
    <if_sid>100100</if_sid>
    <field name="unifi.event_name" type="pcre2">^(WiFi|Wired) Client (Connected|Disconnected)$</field>
    <description>UniFi: $(unifi.msg)</description>
  </rule>

  <!-- Oct 8 triage. The phone (192.168.20.91) keeps hitting the gateway on
       port 80 and the "Trusted to Gateway Mgmt Block" policy drops it every
       time. Level 2 keeps the blocks stored but below the level 3 dashboard
       filter, and 100104 no longer counts them toward its scan threshold. -->

  <rule id="100242" level="2">
    <if_sid>100101</if_sid>
    <srcip>192.168.20.91</srcip>
    <dstport>^80$</dstport>
    <field name="unifi.dst_zone" type="pcre2">^Gateway$</field>
    <description>UniFi: phone blocked from gateway port 80 (expected)</description>
  </rule>

</group>
